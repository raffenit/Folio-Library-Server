# Folio PWA Environment Variables
# These are baked into the build at compile time and available in the browser via process.env.
# For Expo, variables MUST be prefixed with EXPO_PUBLIC_ to be accessible at runtime.
#
# To use: copy this file to .env and fill in the values.
# During Docker build, these are passed via docker-compose build args.
#
# URL CONSTRUCTION:
# If *_URL is set, it is used exactly as specified (for multi-machine deployments).
# If *_URL is NOT set, the URL is auto-constructed from PUBLIC_SERVER_URL hostname + *_PORT:
#   Example: PUBLIC_SERVER_URL=http://100.104.199.67:9000 + KAVITA_PORT=8050
#            → Kavita URL: http://100.104.199.67:8050
# This works perfectly for single-machine deployments where all services share the same host.

# ============================================================================
# Profile Sync Server
# ============================================================================
EXPO_PUBLIC_PUBLIC_SERVER_URL=http://100.104.199.67:9000
EXPO_PUBLIC_PROFILE_API_KEY=

# ============================================================================
# Kavita Server
# ============================================================================
EXPO_PUBLIC_KAVITA_URL=http://localhost:8050
EXPO_PUBLIC_KAVITA_API_KEY=
EXPO_PUBLIC_KAVITA_USERNAME=
EXPO_PUBLIC_KAVITA_PASSWORD=

# ============================================================================
# Audiobookshelf Server
# ============================================================================
EXPO_PUBLIC_ABS_URL=http://localhost:81
EXPO_PUBLIC_ABS_API_KEY=
EXPO_PUBLIC_ABS_USERNAME=
EXPO_PUBLIC_ABS_PASSWORD=

# ============================================================================
# Google Books API (Cover Art & Metadata Search)
# ============================================================================
EXPO_PUBLIC_GOOGLE_BOOKS_API_KEY=

# ============================================================================
# OpenLibrary (optional, defaults to enabled)
# ============================================================================
# EXPO_PUBLIC_OPENLIBRARY_ENABLED=true
