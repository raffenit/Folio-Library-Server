# Multi-stage build for Folio PWA
FROM node:20-alpine AS builder

WORKDIR /app

# Accept build args for environment variables
ARG EXPO_PUBLIC_KAVITA_URL
ARG EXPO_PUBLIC_KAVITA_API_KEY
ARG EXPO_PUBLIC_KAVITA_USERNAME
ARG EXPO_PUBLIC_KAVITA_PASSWORD
ARG EXPO_PUBLIC_ABS_URL
ARG EXPO_PUBLIC_ABS_API_KEY
ARG EXPO_PUBLIC_ABS_USERNAME
ARG EXPO_PUBLIC_ABS_PASSWORD
ARG EXPO_PUBLIC_GOOGLE_BOOKS_API_KEY
ARG EXPO_PUBLIC_PUBLIC_SERVER_URL
ARG EXPO_PUBLIC_PROFILE_API_KEY

# Convert ARG to ENV so Expo can read them during build
ENV EXPO_PUBLIC_KAVITA_URL=${EXPO_PUBLIC_KAVITA_URL}
ENV EXPO_PUBLIC_KAVITA_API_KEY=${EXPO_PUBLIC_KAVITA_API_KEY}
ENV EXPO_PUBLIC_KAVITA_USERNAME=${EXPO_PUBLIC_KAVITA_USERNAME}
ENV EXPO_PUBLIC_KAVITA_PASSWORD=${EXPO_PUBLIC_KAVITA_PASSWORD}
ENV EXPO_PUBLIC_ABS_URL=${EXPO_PUBLIC_ABS_URL}
ENV EXPO_PUBLIC_ABS_API_KEY=${EXPO_PUBLIC_ABS_API_KEY}
ENV EXPO_PUBLIC_ABS_USERNAME=${EXPO_PUBLIC_ABS_USERNAME}
ENV EXPO_PUBLIC_ABS_PASSWORD=${EXPO_PUBLIC_ABS_PASSWORD}
ENV EXPO_PUBLIC_GOOGLE_BOOKS_API_KEY=${EXPO_PUBLIC_GOOGLE_BOOKS_API_KEY}
ENV EXPO_PUBLIC_PUBLIC_SERVER_URL=${EXPO_PUBLIC_PUBLIC_SERVER_URL}
ENV EXPO_PUBLIC_PROFILE_API_KEY=${EXPO_PUBLIC_PROFILE_API_KEY}

# Copy package files
COPY package*.json ./
RUN npm install

# Copy source code
COPY . .

# Build the PWA
RUN npm run build:pwa

# Production stage - Node.js with proxy
FROM node:20-alpine

# Copy built files from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy Node.js server
COPY server.js /app/server.js

WORKDIR /app

# Expose port
EXPOSE 80

CMD ["node", "server.js"]
